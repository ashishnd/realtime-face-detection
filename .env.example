# PostgreSQL (used by backend; compose overrides for containers)
DATABASE_URL=postgresql+psycopg2://megaai:megaai@localhost:5432/megaai

# Comma-separated browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
MAX_WS_MESSAGE_BYTES=2097152
MAX_IMAGE_DIMENSION=4096
MAX_FRAMES_PER_MINUTE=360

# Optional: cap concurrent preview subscribers per session
MAX_PREVIEW_SUBSCRIBERS=8
